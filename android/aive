#!/data/data/com.termux/files/usr/bin/bash
# aive: run the AI Video Editor on Android (installed into Termux by android/install.sh).
#   aive start    start the editor in Debian and open it in the browser (keeps the phone awake while it runs)
#   aive stop     stop it
#   aive login    sign in to Claude and/or Codex
#   aive update   get the newest version of the app (your videos, projects and assets stay)
#   aive logs     the server log          aive shell   a shell inside Debian, in the app folder
#   aive doctor   check the tools
APP=/root/ai-video-editor
PORT=8770
run() { proot-distro login debian --shared-tmp --bind /storage/emulated/0:/sdcard -- bash -lc "$1"; }
up() { curl -s -m 2 -o /dev/null "http://127.0.0.1:$PORT/api/videos"; }

case "${1:-start}" in
  start)
    if ! up; then
      termux-wake-lock 2>/dev/null || true
      # proot keeps running as long as the server does; nohup + & keeps both alive after this command returns.
      # --shared-tmp: Debian's /tmp is Termux's $PREFIX/tmp, so the log is readable from both sides.
      nohup proot-distro login debian --shared-tmp --bind /storage/emulated/0:/sdcard --         bash -lc "cd $APP/app && exec python3 server.py" > "$PREFIX/tmp/ai-video-editor.log" 2>&1 &
      printf "Starting"
      for _ in $(seq 1 60); do sleep 1; printf "."; up && break; done; echo
    fi
    if up; then
      echo "AI Video Editor: http://127.0.0.1:$PORT  (leave Termux running in the background; 'aive stop' to stop)"
      termux-open-url "http://127.0.0.1:$PORT/" 2>/dev/null || true
    else
      echo "It did not start. See: aive logs"; exit 1
    fi ;;
  stop)
    pkill -f "python3 server.py" 2>/dev/null; pkill -f whisper-server 2>/dev/null
    termux-wake-unlock 2>/dev/null || true; echo "Stopped." ;;
  login) run "bash $APP/android/login.sh" ;;
  update)
    run "cd $APP && python3 app/tools/update.py --apply && bash android/setup-debian.sh" ;;
  logs) tail -n 80 "$PREFIX/tmp/ai-video-editor.log" ;;
  shell) proot-distro login debian --shared-tmp --bind /storage/emulated/0:/sdcard -- bash -lc "cd $APP && exec bash -l" ;;
  doctor)
    run "echo; for c in python3 node ffmpeg chromium claude codex; do printf '%-9s ' \$c; (\$c --version 2>/dev/null | head -1) || echo MISSING; done;
         printf 'whisper   '; ls \$HOME/whisper.cpp/build/bin/whisper-cli 2>/dev/null || echo 'not installed (optional: bash $APP/android/setup-debian.sh --speech)';
         python3 $APP/app/tools/learn_assets.py --check; RR_PLATFORM=android python3 $APP/app/gpu.py" ;;
  *) sed -n '2,9p' "$0" ;;
esac
